{
  "version": 2,
  "builds": [
    {
      "src": "sigp-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/sigp-frontend/dist/index.html"
    }
  ]
}
