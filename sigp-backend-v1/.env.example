# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Développement : connexion directe
DATABASE_URL="postgresql://sigp:sigp_dev_pass@localhost:5432/sigp_dev?schema=public"
DIRECT_URL="postgresql://sigp:sigp_dev_pass@localhost:5432/sigp_dev?schema=public"
# Production (Supabase) : DATABASE_URL = pooler transaction (port 6543, ?pgbouncer=true),
# DIRECT_URL = pooler session (port 5432, sans pgbouncer=true) — requis par `prisma migrate`.
# Voir docs/migrations.md. Valeurs réelles définies uniquement dans Render, jamais ici.

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_CACHE=300
REDIS_TTL_DASHBOARD=300

# ─── JWT RS256 ────────────────────────────────────────────────────────────────
# Générer les clés : npm run generate:keys
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_REFRESH_TOKEN_GRACE=30
# Fallback HS256 pour développement sans clés RSA
JWT_SECRET=change-me-min-32-chars-long-secret

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_DOCUMENTS=sigp-documents
MINIO_BUCKET_REPORTS=sigp-reports
MINIO_BUCKET_AVATARS=sigp-avatars

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SIGP No-Reply <noreply@sigp.local>"

# ─── ClamAV ───────────────────────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
ANTIVIRUS_ENABLED=false

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5

# ─── Monitoring ───────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ─── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sigp.local
SEED_ADMIN_PASSWORD=Admin@2024!

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
