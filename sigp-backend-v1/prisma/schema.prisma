  funding_source FundingSource? @relation(fields: [funding_source_id], references: [id])

  @@index([budget_version_id])
  @@index([budget_ligne_id])
  @@index([deleted_at])
  @@map("disbursements")
}

// ActivitiesModule fusionné dans PTBAModule (Blueprint V2)
model PtbaActivite {
  id                String     @id @default(uuid()) @db.Uuid
  project_id        String     @db.Uuid
  wbs_id            String?    @db.Uuid
  logframe_ref_id   String?    @db.Uuid
  code              String     @db.VarChar(50)
  libelle           String     @db.VarChar(500)
  description       String?    @db.Text
  statut            PtbaStatut @default(NON_DEMARRE)
  annee             Int
  trimestre         Int
  date_debut_prevue DateTime?  @db.Date
  date_fin_prevue   DateTime?  @db.Date
  date_debut_reelle DateTime?  @db.Date
  date_fin_reelle   DateTime?  @db.Date
  montant_prevu     Decimal?   @db.Decimal(18, 2)
  montant_realise   Decimal?   @db.Decimal(18, 2)
  taux_realisation  Decimal?   @db.Decimal(5, 2)
  responsable_id    String?    @db.Uuid
  created_by        String?    @db.Uuid
  updated_by        String?    @db.Uuid
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  deleted_at        DateTime?

  project            Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  wbs_node           WbsNode?           @relation(fields: [wbs_id], references: [id])
  logframe_indicator LogframeIndicator? @relation(fields: [logframe_ref_id], references: [id])

