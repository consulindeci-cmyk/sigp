// SIGP ERP — Prisma Schema V2
// Source de vérité : Blueprint Backend V2
// NE PAS modifier la structure sans validation architecturale

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (non-pooled) utilisée par `prisma migrate` — le pooler
  // PgBouncer en mode transaction (port 6543) ne supporte pas les advisory locks.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMs
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COORDINATEUR
  CHARGE_PROGRAMME
  FINANCIER
  AUDITEUR
  VIEWER
}

enum ProjectStatus {
  EN_PREPARATION
  EN_COURS
  SUSPENDU
  CLOTURE
  ANNULE
}

enum RoleMembreProjet {
  CHEF_PROJET
  COORDINATEUR
  MEMBRE
  OBSERVATEUR
  VALIDATEUR
}

enum BudgetStatus {
  BROUILLON
  SOUMIS
  APPROUVE
  REVISE
  CLOTURE
}

enum RiskProbability {
  FAIBLE
  POSSIBLE
  PROBABLE
  QUASI_CERTAIN
}

enum RiskImpact {
  FAIBLE
  MODERE
  IMPORTANT
  CRITIQUE
}

enum RiskStatus {
  OUVERT
  EN_COURS
  RESOLU
  ACCEPTE
  FERME
}

enum LivrableStatus {
  NON_COMMENCE
  EN_COURS
  SOUMIS
  EN_REVISION
  VALIDE
  REJETE
  EN_RETARD
}

enum PpmMarcheStatus {
  EN_PREPARATION
  LANCE
  SOUMISSION
  EVALUATION
  ATTRIBUTION
  SIGNE
  RESILIE
  CLOTURE
}

enum PpmTypeMarche {
  FOURNITURES
  TRAVAUX
  SERVICES
  CONSULTANTS
}

enum ContractStatus {
  ACTIF
  SUSPENDU
  CLOTURE
  RESILIE
}

enum ContractType {
  MARCHE
  CONVENTION
  PROTOCOLE
  LETTRE_ACCORD
}

enum DisbursementStatus {
  PLANIFIE
  DEMANDE
  APPROUVE
  DECAISSE
  REJETE
}

enum PtbaStatut {
  NON_DEMARRE
  EN_COURS
  TERMINE
  ANNULE
  EN_RETARD
}

enum DocumentStatus {
  BROUILLON
  SOUMIS
  VALIDE
  REJETE
  ARCHIVE
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportType {
  BUDGET
  EVM
  RISQUES
  GLOBAL
  PTBA
  EXPORT_EXCEL
}

enum TypeRapport {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
  FINANCIER
  EVM
  RISQUES
  PTBA
  BAILLEUR
  AVANCEMENT
  FINAL
}

enum StatutRapport {
  GENERE
  EN_ATTENTE
  VALIDE
  ARCHIVE
}

enum FormatRapport {
  PDF
  EXCEL
  WORD
}

enum TypeNotification {
  RISQUE_CRITIQUE
  LIVRABLE_EN_RETARD
  BUDGET_DEPASSE
  EVM_ALERTE_CPI
  EVM_ALERTE_SPI
  DOCUMENT_VALIDE
  RAPPORT_PRET
  MENTION_COMMENTAIRE
  PROJET_STATUT_CHANGE
  BUDGET_VALIDE
  CONTRAT_EXPIRE
  PAIEMENT_DU
  INVITATION_PROJET
}

enum WbsNodeType {
  PHASE
  LOT
  ACTIVITE
  LIVRABLE
}

enum FundingSourceType {
  BAILLEUR
  CONTREPARTIE_NATIONALE
  AUTRE
}

enum LogframeLevel {
  OBJECTIF_GLOBAL
  OBJECTIF_SPECIFIQUE
  RESULTAT
  ACTIVITE
}

enum IndicatorType {
  IMPACT
  OUTCOME
  OUTPUT
  PROCESS
}

enum JournalType {
  RECETTE
  DEPENSE
  VIREMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  VALIDATE
  REJECT
}

enum OrganisationType {
  MINISTERE
  INSTITUTION
  ONG
  PARTENAIRE
  COLLECTIVITE
  AUTRE
}

enum ProgrammeStatus {
  EN_PREPARATION
  EN_COURS
  SUSPENDU
  CLOTURE
  ANNULE
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  nom                String    @db.VarChar(100)
  prenom             String    @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  mot_de_passe       String    @db.VarChar(255)
  role               UserRole  @default(VIEWER)
  actif              Boolean   @default(true)
  langue_preference  String    @default("fr") @db.VarChar(5)
  telephone          String?   @db.VarChar(30)
  avatar_url         String?   @db.VarChar(500)
  derniere_connexion DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  refresh_tokens      RefreshToken[]
  project_memberships ProjectMember[]
  gouvernance_entries Gouvernance[]
  historique          Historique[]
  notifications       Notification[]
  notification_prefs  NotificationPreference?
  managed_projects    Project[]               @relation("ProjectManager")
  created_projects    Project[]               @relation("ProjectCreator")
  comments            Comment[]

  organisation_id String?       @db.Uuid
  organisation    Organisation? @relation(fields: [organisation_id], references: [id])

  @@index([email])
  @@index([deleted_at])
  @@index([organisation_id])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  family_id  String    @db.Uuid
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// GOUVERNANCE — Hiérarchie organisationnelle (Blueprint V2)
// Organisation → Direction → Departement → Unite → Programme → Project
// ─────────────────────────────────────────────────────────────────────────────

model Organisation {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  nom         String           @unique @db.VarChar(200)
  type        OrganisationType @default(AUTRE)
  description String?          @db.Text
  email       String?          @db.VarChar(255)
  telephone   String?          @db.VarChar(30)
  site_web    String?          @db.VarChar(255)
  actif       Boolean          @default(true)
  created_by  String?          @db.Uuid
  updated_by  String?          @db.Uuid
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?

  directions Direction[]
  users      User[]

  @@index([actif])
  @@index([deleted_at])
  @@map("organisations")
}

model Direction {
  id              String    @id @default(uuid()) @db.Uuid
  organisation_id String    @db.Uuid
  code            String    @db.VarChar(50)
  nom             String    @db.VarChar(200)
  description     String?   @db.Text
  actif           Boolean   @default(true)
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  organisation Organisation  @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  departements Departement[]

  @@unique([organisation_id, code])
  @@unique([organisation_id, nom])
  @@index([organisation_id])
  @@index([deleted_at])
  @@map("directions")
}

model Departement {
  id           String    @id @default(uuid()) @db.Uuid
  direction_id String    @db.Uuid
  code         String    @db.VarChar(50)
  nom          String    @db.VarChar(200)
  description  String?   @db.Text
  actif        Boolean   @default(true)
  created_by   String?   @db.Uuid
  updated_by   String?   @db.Uuid
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  direction Direction @relation(fields: [direction_id], references: [id], onDelete: Cascade)
  unites    Unite[]

  @@unique([direction_id, code])
  @@unique([direction_id, nom])
  @@index([direction_id])
  @@index([deleted_at])
  @@map("departements")
}

model Unite {
  id             String    @id @default(uuid()) @db.Uuid
  departement_id String    @db.Uuid
  code           String    @db.VarChar(50)
  nom            String    @db.VarChar(200)
  description    String?   @db.Text
  actif          Boolean   @default(true)
  created_by     String?   @db.Uuid
  updated_by     String?   @db.Uuid
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  departement Departement @relation(fields: [departement_id], references: [id], onDelete: Cascade)
  programmes  Programme[]

  @@unique([departement_id, code])
  @@unique([departement_id, nom])
  @@index([departement_id])
  @@index([deleted_at])
  @@map("unites")
}

model Programme {
  id          String          @id @default(uuid()) @db.Uuid
  unite_id    String          @db.Uuid
  code        String          @db.VarChar(50)
  nom         String          @db.VarChar(200)
  description String?         @db.Text
  statut      ProgrammeStatus @default(EN_PREPARATION)
  actif       Boolean         @default(true)
  date_debut  DateTime?       @db.Date
  date_fin    DateTime?       @db.Date
  created_by  String?         @db.Uuid
  updated_by  String?         @db.Uuid
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  deleted_at  DateTime?

  unite    Unite     @relation(fields: [unite_id], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([unite_id, code])
  @@unique([unite_id, nom])
  @@index([unite_id])
  @@index([statut])
  @@index([deleted_at])
  @@map("programmes")
}

model Project {
  id                     String        @id @default(uuid()) @db.Uuid
  code                   String        @unique @db.VarChar(50)
  nom                    String        @db.VarChar(255)
  description            String?       @db.Text
  statut                 ProjectStatus @default(EN_PREPARATION)
  date_debut             DateTime?     @db.Date
  date_fin_prevue        DateTime?     @db.Date
  date_fin_effective     DateTime?     @db.Date
  date_cloture_effective DateTime?     @db.Date
  manager_id             String?       @db.Uuid
  programme_id           String?       @db.Uuid
  budget_total           Decimal?      @db.Decimal(18, 2)
  devise                 String        @default("XOF") @db.VarChar(3)
  pays                   String?       @db.VarChar(100)
  secteur                String?       @db.VarChar(100)
  bailleur_principal     String?       @db.VarChar(255)
  created_by             String?       @db.Uuid
  updated_by             String?       @db.Uuid
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  deleted_at             DateTime?

  manager             User?               @relation("ProjectManager", fields: [manager_id], references: [id])
  creator             User?               @relation("ProjectCreator", fields: [created_by], references: [id])
  programme           Programme?          @relation(fields: [programme_id], references: [id])
  members             ProjectMember[]
  gouvernance         Gouvernance[]
  logframe_objectives LogframeObjective[]
  wbs_nodes           WbsNode[]
  budget_versions     BudgetVersion[]
  funding_sources     FundingSource[]
  ppm_marches         PpmMarche[]
  contracts           Contract[]
  ptba_activites      PtbaActivite[]
  risques             Risque[]
  livrables           Livrable[]
  evm_snapshots       EvmSnapshot[]
  documents           DocumentProjet[]
  rapports_projet     RapportProjet[]
  reports             Report[]
  historique          Historique[]
  notifications       Notification[]
  comments            Comment[]

  @@index([statut])
  @@index([manager_id])
  @@index([programme_id])
  @@index([programme_id, statut])
  @@index([deleted_at])
  @@map("projects")
}

model ProjectMember {
  id          String           @id @default(uuid()) @db.Uuid
  project_id  String           @db.Uuid
  user_id     String           @db.Uuid
  role_projet RoleMembreProjet @default(MEMBRE)
  actif       Boolean          @default(true)
  date_debut  DateTime?        @db.Date
  date_fin    DateTime?        @db.Date
  created_by  String?          @db.Uuid
  updated_by  String?          @db.Uuid
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@index([deleted_at])
  @@map("project_members")
}

// Sub-module de ProjectsModule (Blueprint V2)
model Gouvernance {
  id           String    @id @default(uuid()) @db.Uuid
  project_id   String    @db.Uuid
  nom          String    @db.VarChar(200)
  role         String    @db.VarChar(100)
  organisation String?   @db.VarChar(200)
  email        String?   @db.VarChar(255)
  telephone    String?   @db.VarChar(30)
  user_id      String?   @db.Uuid
  created_by   String?   @db.Uuid
  updated_by   String?   @db.Uuid
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [user_id], references: [id])

  @@index([project_id])
  @@map("gouvernance")
}

model LogframeObjective {
  id          String        @id @default(uuid()) @db.Uuid
  project_id  String        @db.Uuid
  niveau      LogframeLevel
  code        String        @db.VarChar(20)
  libelle     String        @db.Text
  description String?       @db.Text
  parent_id   String?       @db.Uuid
  ordre       Int           @default(0)
  actif       Boolean       @default(true)
  created_by  String?       @db.Uuid
  updated_by  String?       @db.Uuid
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  deleted_at  DateTime?

  project    Project             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent     LogframeObjective?  @relation("LogframeHierarchy", fields: [parent_id], references: [id])
  children   LogframeObjective[] @relation("LogframeHierarchy")
  indicators LogframeIndicator[]
  wbs_nodes  WbsNode[]

  @@index([project_id])
  @@index([deleted_at])
  @@map("logframe_objectives")
}

model LogframeIndicator {
  id                  String        @id @default(uuid()) @db.Uuid
  objective_id        String        @db.Uuid
  code                String        @db.VarChar(30)
  libelle             String        @db.Text
  type                IndicatorType @default(OUTPUT)
  unite               String?       @db.VarChar(50)
  valeur_baseline     Decimal?      @db.Decimal(18, 4)
  valeur_cible        Decimal?      @db.Decimal(18, 4)
  valeur_actuelle     Decimal?      @db.Decimal(18, 4)
  source_verification String?       @db.Text
  periodicite         String?       @db.VarChar(50)
  actif               Boolean       @default(true)
  created_by          String?       @db.Uuid
  updated_by          String?       @db.Uuid
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  deleted_at          DateTime?

  objective      LogframeObjective @relation(fields: [objective_id], references: [id], onDelete: Cascade)
  ptba_activites PtbaActivite[]

  @@index([objective_id])
  @@index([deleted_at])
  @@map("logframe_indicators")
}

model WbsNode {
  id             String      @id @default(uuid()) @db.Uuid
  project_id     String      @db.Uuid
  parent_id      String?     @db.Uuid
  objective_id   String?     @db.Uuid
  code           String      @db.VarChar(30)
  libelle        String      @db.VarChar(500)
  type           WbsNodeType
  ordre          Int         @default(0)
  niveau         Int         @default(1)
  responsable_id String?     @db.Uuid
  actif          Boolean     @default(true)
  date_debut     DateTime?   @db.Date
  date_fin       DateTime?   @db.Date
  created_by     String?     @db.Uuid
  updated_by     String?     @db.Uuid
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  deleted_at     DateTime?

  project        Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent         WbsNode?           @relation("WbsHierarchy", fields: [parent_id], references: [id])
  children       WbsNode[]          @relation("WbsHierarchy")
  objective      LogframeObjective? @relation(fields: [objective_id], references: [id])
  risques        Risque[]
  livrables      Livrable[]
  ptba_activites PtbaActivite[]

  @@index([project_id])
  @@index([objective_id])
  @@index([deleted_at])
  @@map("wbs_nodes")
}

model BudgetVersion {
  id            String       @id @default(uuid()) @db.Uuid
  project_id    String       @db.Uuid
  version       Int          @default(1)
  nom           String       @db.VarChar(100)
  statut        BudgetStatus @default(BROUILLON)
  montant_total Decimal      @default(0) @db.Decimal(18, 2)
  approuve_par  String?      @db.Uuid
  approuve_le   DateTime?
  notes         String?      @db.Text
  created_by    String?      @db.Uuid
  updated_by    String?      @db.Uuid
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted_at    DateTime?

  project       Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  lignes        BudgetLigne[]
  disbursements Disbursement[]

  @@unique([project_id, version])
  @@index([deleted_at])
  @@map("budget_versions")
}

model BudgetLigne {
  id             String    @id @default(uuid()) @db.Uuid
  version_id     String    @db.Uuid
  parent_id      String?   @db.Uuid
  code_ligne     String    @db.VarChar(30)
  libelle        String    @db.VarChar(500)
  categorie      String?   @db.VarChar(100)
  montant_prevu  Decimal   @default(0) @db.Decimal(18, 2)
  montant_engage Decimal   @default(0) @db.Decimal(18, 2)
  montant_paye   Decimal   @default(0) @db.Decimal(18, 2)
  ordre          Int       @default(0)
  created_by     String?   @db.Uuid
  updated_by     String?   @db.Uuid
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  version       BudgetVersion      @relation(fields: [version_id], references: [id], onDelete: Cascade)
  parent        BudgetLigne?       @relation("BudgetHierarchy", fields: [parent_id], references: [id])
  children      BudgetLigne[]      @relation("BudgetHierarchy")
  journal_ops   JournalOperation[]
  disbursements Disbursement[]

  @@unique([version_id, code_ligne])
  @@index([version_id])
  @@index([deleted_at])
  @@map("budget_lignes")
}

// Sub-module de BudgetModule (Blueprint V2)
model JournalOperation {
  id              String      @id @default(uuid()) @db.Uuid
  budget_ligne_id String      @db.Uuid
  type            JournalType
  montant         Decimal     @db.Decimal(18, 2)
  date_operation  DateTime    @db.Date
  reference       String?     @db.VarChar(100)
  description     String?     @db.Text
  piece_jointe_id String?     @db.Uuid
  created_by      String?     @db.Uuid
  updated_by      String?     @db.Uuid
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?

  budget_ligne BudgetLigne @relation(fields: [budget_ligne_id], references: [id])

  @@index([budget_ligne_id])
  @@index([deleted_at])
  @@map("journal_operations")
}

model FundingSource {
  id          String            @id @default(uuid()) @db.Uuid
  project_id  String            @db.Uuid
  nom         String            @db.VarChar(255)
  type        FundingSourceType @default(BAILLEUR)
  montant     Decimal           @db.Decimal(18, 2)
  pourcentage Decimal?          @db.Decimal(5, 2)
  devise      String            @default("XOF") @db.VarChar(3)
  date_accord DateTime?         @db.Date
  date_expiry DateTime?         @db.Date
  contact     String?           @db.VarChar(200)
  notes       String?           @db.Text
  created_by  String?           @db.Uuid
  updated_by  String?           @db.Uuid
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  deleted_at  DateTime?

  project       Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  disbursements Disbursement[]

  @@index([project_id])
  @@index([deleted_at])
  @@map("funding_sources")
}

model PpmMarche {
  id                    String          @id @default(uuid()) @db.Uuid
  project_id            String          @db.Uuid
  code                  String          @db.VarChar(50)
  intitule              String          @db.VarChar(500)
  type                  PpmTypeMarche
  statut                PpmMarcheStatus @default(EN_PREPARATION)
  montant_estime        Decimal?        @db.Decimal(18, 2)
  montant_signe         Decimal?        @db.Decimal(18, 2)
  date_lancement_prevu  DateTime?       @db.Date
  date_soumission_prevu DateTime?       @db.Date
  date_attribution      DateTime?       @db.Date
  date_signature        DateTime?       @db.Date
  date_fin_prevue       DateTime?       @db.Date
  date_fin_effective    DateTime?       @db.Date
  titulaire             String?         @db.VarChar(255)
  notes                 String?         @db.Text
  created_by            String?         @db.Uuid
  updated_by            String?         @db.Uuid
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  deleted_at            DateTime?

  project   Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  etapes    PpmEtape[]
  contracts Contract[]

  @@unique([project_id, code])
  @@index([project_id])
  @@index([deleted_at])
  @@map("ppm_marches")
}

model PpmEtape {
  id          String    @id @default(uuid()) @db.Uuid
  marche_id   String    @db.Uuid
  libelle     String    @db.VarChar(200)
  ordre       Int
  date_prevue DateTime? @db.Date
  date_reelle DateTime? @db.Date
  complete    Boolean   @default(false)
  notes       String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  marche PpmMarche @relation(fields: [marche_id], references: [id], onDelete: Cascade)

  @@map("ppm_etapes")
}

model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  project_id     String         @db.Uuid
  marche_id      String?        @db.Uuid
  numero         String         @db.VarChar(100)
  intitule       String         @db.VarChar(500)
  type           ContractType   @default(MARCHE)
  statut         ContractStatus @default(ACTIF)
  titulaire      String         @db.VarChar(255)
  montant        Decimal        @db.Decimal(18, 2)
  devise         String         @default("XOF") @db.VarChar(3)
  date_signature DateTime?      @db.Date
  date_debut     DateTime?      @db.Date
  date_fin       DateTime?      @db.Date
  notes          String?        @db.Text
  created_by     String?        @db.Uuid
  updated_by     String?        @db.Uuid
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?

  project       Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  marche        PpmMarche?     @relation(fields: [marche_id], references: [id])
  disbursements Disbursement[]

  @@index([project_id])
  @@index([project_id, statut])
  @@index([deleted_at])
  @@map("contracts")
}

model Disbursement {
  id                String             @id @default(uuid()) @db.Uuid
  budget_version_id String?            @db.Uuid
  budget_ligne_id   String?            @db.Uuid
  contract_id       String?            @db.Uuid
  funding_source_id String?            @db.Uuid
  statut            DisbursementStatus @default(PLANIFIE)
  montant           Decimal            @db.Decimal(18, 2)
  date_prevue       DateTime?          @db.Date
  date_reelle       DateTime?          @db.Date
  reference         String?            @db.VarChar(100)
  description       String?            @db.Text
  created_by        String?            @db.Uuid
  updated_by        String?            @db.Uuid
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  deleted_at        DateTime?

  budget_version BudgetVersion? @relation(fields: [budget_version_id], references: [id])
  budget_ligne   BudgetLigne?   @relation(fields: [budget_ligne_id], references: [id])
