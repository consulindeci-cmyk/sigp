// Pas de partitioning — incompatible Prisma. Index + retention 24 mois via cron
model Historique {
  id                String      @id @default(uuid()) @db.Uuid
  project_id        String?     @db.Uuid
  user_id           String?     @db.Uuid
  action            AuditAction
  table_cible       String      @db.VarChar(100)
  enregistrement_id String?     @db.VarChar(36)
  avant             Json?
  apres             Json?
  ip_address        String?     @db.VarChar(45)
  user_agent        String?     @db.Text
  created_at        DateTime    @default(now())

  project Project? @relation(fields: [project_id], references: [id])
  user    User?    @relation(fields: [user_id], references: [id])

  @@index([project_id])
  @@index([user_id])
  @@index([created_at])
  @@map("historique")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  user_id    String           @db.Uuid
  project_id String?          @db.Uuid
  type       TypeNotification
  titre      String           @db.VarChar(200)
  message    String           @db.Text
  lue        Boolean          @default(false)
  data       Json?
  expires_at DateTime?
  created_by String?          @db.Uuid
  updated_by String?          @db.Uuid
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  deleted_at DateTime?

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id])

  @@index([user_id, lue])
  @@index([expires_at])
  @@index([deleted_at])
  @@map("notifications")
}

model NotificationPreference {
  id                    String  @id @default(uuid()) @db.Uuid
  user_id               String  @unique @db.Uuid
  email_risque_critique Boolean @default(true)
  email_livrable_retard Boolean @default(true)
  email_budget_depasse  Boolean @default(true)
  email_rapport_pret    Boolean @default(true)
  email_mention         Boolean @default(true)
  in_app_all            Boolean @default(true)
  frequence_digest      String  @default("daily") @db.VarChar(20)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Comment {
  id           String    @id @default(uuid()) @db.Uuid
  project_id   String    @db.Uuid
  user_id      String    @db.Uuid
  parent_id    String?   @db.Uuid
  module       String?   @db.VarChar(100)
  element_id   String?   @db.VarChar(100)
  element_nom  String?   @db.VarChar(500)
  message      String    @db.Text
  statut       String    @default("OUVERT") @db.VarChar(50)
  priorite     String    @default("NORMALE") @db.VarChar(50)
  piece_jointe String?   @db.VarChar(500)
  mention      String?   @db.VarChar(500)
  lu           Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  project Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [user_id], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parent_id], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([project_id])
  @@index([user_id])
  @@map("comments")
}
