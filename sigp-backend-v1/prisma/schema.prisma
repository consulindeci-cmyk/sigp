model Risque {
  id               String          @id @default(uuid()) @db.Uuid
  project_id       String          @db.Uuid
  wbs_id           String?         @db.Uuid
  code             String?         @db.VarChar(20)
  description      String          @db.Text
  categorie        String?         @db.VarChar(100)
  probabilite      RiskProbability
  impact           RiskImpact
  niveau_criticite String          @db.VarChar(20)
  statut           RiskStatus      @default(OUVERT)
  strategie        String?         @db.Text
  plan_action      String?         @db.Text
  responsable_id   String?         @db.Uuid
  date_detection   DateTime?       @db.Date
  date_echeance    DateTime?       @db.Date
  created_by       String?         @db.Uuid
  updated_by       String?         @db.Uuid
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  deleted_at       DateTime?

  project  Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  wbs_node WbsNode? @relation(fields: [wbs_id], references: [id])

  @@index([project_id, statut])
  @@index([deleted_at])
  @@map("risques")
}

model Livrable {
  id              String         @id @default(uuid()) @db.Uuid
  project_id      String         @db.Uuid
  wbs_id          String?        @db.Uuid
  code            String?        @db.VarChar(20)
  nom             String         @db.VarChar(300)
